{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git checkout main)",
      "Bash(git checkout -b:*)",
      "Bash(git switch main)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git config core.hooksPath:*)"
    ]
  }
}
