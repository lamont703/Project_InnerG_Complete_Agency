scripts/gsc_*.js
scratchpad_reports/

# Crash-resume checkpoint written by scripts/sync_entities_to_ghl.js
scripts/.ghl_sync_progress.json

# Google Cross-Account Protection service-account key (see
# scripts/register_risc_endpoint.js). Both cases are listed on purpose: the file
# on disk is lowercase, and it only matched the uppercase pattern because macOS
# is case-insensitive. On Linux — CI, a container build, a teammate's machine —
# the uppercase line alone would NOT match, and the private key would be
# committable. Anything matching risc*key.json is ignored regardless of case.
RISC-SERVICE-KEY.json
risc-service-key.json
risc*key.json

# Ed25519 private key proving ownership of innergcomplete.com to the MCP
# registry (see the MCP section in CLAUDE.md). Whoever holds it can publish
# under com.innergcomplete/* — it is a publishing credential, not a secret that
# only reads. Patterns are broad on purpose, following the RISC key above: the
# risk is a variant filename slipping past a narrow rule on a case-sensitive
# filesystem.
mcp-registry-key.pem
mcp-registry-key*.pem
*mcp*key*.pem
mcp-registry-auth

# Python bytecode caches.
#
# venv/ is tracked in this repo deliberately (11,154 non-bytecode files), but
# the compiled caches under it are not source — CPython regenerates them from
# the .py files whenever they are missing or stale. Running any script that
# imports pypdf dirties ~48 of them, which buries a real diff under binary
# noise and has already had to be reverted by hand twice.
#
# NOTE: an ignore rule does not untrack files that are already in the index.
# The 8,485 __pycache__ files committed under venv/ keep appearing in
# `git status` until they are removed with `git rm --cached`.
__pycache__/
*.py[cod]
*$py.class

# Regulator reference libraries — mirrored PDFs from state licensing boards.
# Deliberately NOT committed: the California set alone is several hundred MB of
# third-party government documents that a script reproduces in minutes, and
# fresher than any commit would hold. scripts/fetch_*_pdfs.js IS the archive.
# They also must not sit under public/, where they would be served and crawled
# as duplicates of the .gov originals.
reference/
.ca_bbc_added.json

# Fixture photographs for the AR overlay harness (/ar-lab,
# scripts/ar_lab_shot.js), and the PNGs it writes.
#
# Photographs of real heads do not belong in this repository — not the client's,
# not the student's, not yours. The harness reads them from local disk in the
# browser and uploads nothing, so keeping them out of git costs nothing and is
# the difference between a rendering test and a face dataset.
#
# Mannequin heads are the right fixture anyway: they are the primary use case,
# they hold still, and nobody has to consent to one.
ar-fixtures/
ar-lab-shot*.png

# Puppeteer profile for retained AR calibration marks.
.ar-lab-profile/
